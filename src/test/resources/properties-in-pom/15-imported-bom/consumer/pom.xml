<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <!-- Test case: Import the locally installed BOM at bom.version=1.0; expect JUnit 4.13.2, without importing the BOM's properties. -->
    <groupId>example.properties</groupId>
    <artifactId>bom-consumer</artifactId>
    <version>1.0</version>
    <properties>
        <bom.version>1.0</bom.version>
    </properties>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>example.properties</groupId>
                <artifactId>example-bom</artifactId>
                <version>${bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <dependencies>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
        </dependency>
    </dependencies>
</project>
